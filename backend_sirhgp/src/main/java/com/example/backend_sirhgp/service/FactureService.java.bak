@Slf4j
@Service
@RequiredArgsConstructor
public class FactureService {

    private final FactureRepository factureRepository;
    private final ProjetRepository projetRepository;
    private final EmployerRepository employerRepository;
    private final TacheRepository tacheRepository;
    private final PaiementFactureRepository paiementFactureRepository;
    private final EcritureComptableRepository ecritureComptableRepository;
    private final FactureMapper factureMapper;
    private final LigneFactureMapper ligneFactureMapper;
    private final ApplicationEventPublisher eventPublisher;
    private final AuditLogService auditLogService;
    private final EntrepriseContextService entrepriseContextService;
    private final SucursalAttributionService sucursalAttribution;

    // ─── CRUD de base ─────────────────────────────────────────────────────────

    @Transactional
    public FactureResponseDTO create(FactureRequestDTO dto) {
        Facture facture = factureMapper.toEntity(dto);
        Employer emetteur = getCurrentUser();
        facture.setEmetteur(emetteur);
        // 5.9 bis : succursale d'origine — demandée par l'ADMIN (plusieurs agences),
        // sinon celle du créateur ; résolue après rattachement entreprise (ligne OHADA).

        if (dto.getProjetId() != null) {
            Projet projet = projetRepository.findById(dto.getProjetId())
                    .orElseThrow(() -> new ResourceNotFoundException("Projet non trouvé : " + dto.getProjetId()));
            facture.setProjet(projet);
        }

        // Cycle achat/vente : document d'origine (PROFORMA -> BON_COMMANDE -> REGULIERE)
        if (dto.getFactureOrigineId() != null) {
            Facture origine = factureRepository.findById(dto.getFactureOrigineId())
                    .orElseThrow(() -> new ResourceNotFoundException("Document d'origine non trouvé : " + dto.getFactureOrigineId()));
            facture.setFactureOrigine(origine);
            if (dto.getSens() == null && origine.getSens() != null) {
                facture.setSens(origine.getSens());
            }
        }
        if (dto.getSens() != null) {
            facture.setSens(dto.getSens());
        }

        // ─── Cycle achat/vente : document d'origine (PROFORMA → BON_COMMANDE → REGULIERE)
        if (dto.getFactureOrigineId() != null) {
            Facture origine = factureRepository.findById(dto.getFactureOrigineId())
                    .orElseThrow(() -> new ResourceNotFoundException("Document d'origine non trouvé : " + dto.getFactureOrigineId()));
            facture.setFactureOrigine(origine);
            // Héritage du sens si non précisé
            if (dto.getSens() == null && origine.getSens() != null) {
                facture.setSens(origine.getSens());
            }
        }
        if (dto.getSens() != null) {
            facture.setSens(dto.getSens());
        }

        if (dto.getClientId() != null) {
            Employer client = employerRepository.findById(dto.getClientId())
                    .orElseThrow(() -> new ResourceNotFoundException("Client non trouvé : " + dto.getClientId()));
            facture.setClient(client);
            facture.setDateEnvoi(LocalDateTime.now());
        }

        if (dto.getLignesFacture() != null && !dto.getLignesFacture().isEmpty()) {
            for (LigneFactureRequestDTO ligneDto : dto.getLignesFacture()) {
                LigneFacture ligne = ligneFactureMapper.toEntity(ligneDto);
                if (ligneDto.getTacheId() != null) {
                    Tache tache = tacheRepository.findById(ligneDto.getTacheId())
                            .orElseThrow(() -> new ResourceNotFoundException("Tâche non trouvée : " + ligneDto.getTacheId()));
                    ligne.setTache(tache);
                }
                facture.addLigneFacture(ligne);
            }
        }

        // OHADA : rattachement entreprise + numerotation sequentielle FAC-ANNEE-NNNN
        if (facture.getEntreprise() == null) {
            facture.setEntreprise(entrepriseContextService.getEntrepriseOfCurrentUser());
        }
        // 5.9 bis : succursale d'origine (ADMIN = agence choisie, MANAGER = la sienne,
        // défaut = celle du créateur, sinon NULL = siège).
        facture.setSucursal(sucursalAttribution.resoudreCreation(
                dto.getSucursalId(), facture.getEntreprise()));
        // Contextualisation OHADA :
        // - Facturation INTERNE (client = collaborateur du groupe) : non assujettie a la TVA ;
        // - Facturation EXTERNE (destinataire libre) : TVA 19,25 % applicable.
        if (dto.getAssujettiTVA() == null) {
            facture.setAssujettiTVA(dto.getClientId() == null);
        }
        // Matrice module comptable interne -> compte produit SYSCOHADA (si la ligne ne precise pas de compte)
        for (LigneFacture l : facture.getLignesFacture()) {
            if (l.getCompteComptable() == null || "706".equals(l.getCompteComptable())) {
                l.setCompteComptable(compteProduitDuModule(facture.getModule()));
            }
        }

        attribuerNumerotation(facture);

        facture.calculerMontants();
        Facture saved = factureRepository.save(facture);
        updateBudgetProjet(saved);

        // Audit : création d'une facture
        auditLogService.record(emetteur, AuditActionType.CREATE,
                "Création de la facture " + saved.getNumeroFacture() + " - " + saved.getTitre(),
                "Facture", saved.getId(), saved.getNumeroFacture());

        log.info("Facture créée : {} - {}", saved.getNumeroFacture(), saved.getTitre());
        return enrich(factureMapper.toResponseDTO(saved), saved);
    }

    @Transactional(readOnly = true)
    public Page<FactureResponseDTO> findAll(Pageable pageable) {
        // Multi-tenant : un non-SUPER_ADMIN ne voit que les factures de son entreprise.
        Long scopeEntrepriseId = entrepriseContextService.getScopeEntrepriseId();
        // 5.9 : scoping fin par sucursale (MANAGER/LEAD rattachés) — null-inclusif.
        Long scopeSucursalId = entrepriseContextService.getScopeSucursalId();
        Page<Facture> page;
        if (scopeSucursalId != null) {
            page = factureRepository.findByScopeSucursal(scopeEntrepriseId, scopeSucursalId, pageable);
        } else if (scopeEntrepriseId != null) {
            page = factureRepository.findByEntrepriseId(scopeEntrepriseId, pageable);
        } else {
            page = factureRepository.findAll(pageable);
        }
        return page.map(f -> enrich(factureMapper.toResponseDTO(f), f));
    }

    @Transactional(readOnly = true)
    public FactureResponseDTO findById(Long id) {
        Facture facture = factureRepository.findByIdWithRelations(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée : " + id));
        return enrich(factureMapper.toResponseDTO(facture), facture);
    }

    @Transactional(readOnly = true)
    public List<FactureResponseDTO> findByProjetId(Long projetId) {
        return factureRepository.findByProjetId(projetId).stream()
                .map(f -> enrich(factureMapper.toResponseDTO(f), f))
                .collect(Collectors.toList());
    }

    @Transactional
    public FactureResponseDTO update(Long id, FactureRequestDTO dto) {
        Facture facture = factureRepository.findByIdWithRelations(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée : " + id));
        factureMapper.updateEntity(facture, dto);
        // 5.9 bis : re-rattachement de la succursale d'origine par un ADMIN
        // (sucursalId null = attribution conservée ; refusé pour un compte scopé).
        facture.setSucursal(sucursalAttribution.resoudreModification(
                dto.getSucursalId(), facture.getSucursal(), facture.getEntreprise()));
        facture.calculerMontants();
        Facture saved = factureRepository.save(facture);
        updateBudgetProjet(saved);

        // Audit : modification d'une facture
        auditLogService.record(getCurrentUser(), AuditActionType.UPDATE,
                "Modification de la facture " + saved.getNumeroFacture(),
                "Facture", saved.getId(), saved.getNumeroFacture());

        return enrich(factureMapper.toResponseDTO(saved), saved);
    }

    @Transactional
    public FactureResponseDTO updateStatut(Long id, Facture.StatutFacture statut) {
        Facture facture = factureRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée : " + id));
        facture.setStatut(statut);
        facture.calculerMontants();
        Facture saved = factureRepository.save(facture);

        // Audit : changement de statut d'une facture
        auditLogService.record(getCurrentUser(), AuditActionType.UPDATE,
                "Changement de statut de la facture " + saved.getNumeroFacture() + " vers " + statut,
                "Facture", saved.getId(), saved.getNumeroFacture());

        return enrich(factureMapper.toResponseDTO(saved), saved);
    }

    @Transactional
    public FactureResponseDTO enregistrerPaiement(Long id, BigDecimal montant) {
        if (montant == null || montant.compareTo(BigDecimal.ZERO) <= 0) {
            throw new IllegalArgumentException("Le montant du paiement doit être positif");
        }
        Facture facture = factureRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée : " + id));

        facture.setMontantPaye(facture.getMontantPaye().add(montant));
        facture.calculerMontants();
        facture = factureRepository.save(facture);
        updateBudgetProjet(facture);

        // Audit : paiement d'une facture
        auditLogService.record(getCurrentUser(), AuditActionType.UPDATE,
                "Paiement de " + montant + " FCFA sur la facture " + facture.getNumeroFacture(),
                "Facture", facture.getId(), facture.getNumeroFacture());

        return enrich(factureMapper.toResponseDTO(facture), facture);
    }

    @Transactional
    public void delete(Long id) {
        if (!factureRepository.existsById(id)) {
            throw new ResourceNotFoundException("Facture non trouvée : " + id);
        }
        factureRepository.deleteById(id);

        // Audit : suppression d'une facture
        auditLogService.record(getCurrentUser(), AuditActionType.DELETE,
                "Suppression de la facture (id=" + id + ")",
                "Facture", id, null);

        log.info("Facture supprimée : {}", id);
    }

    // ─── DISPATCH (ENVOI AU CLIENT) ───────────────────────────────────────────

    @Transactional
    public FactureResponseDTO dispatchToClient(Long factureId, FactureDispatchRequestDTO dto) {
        Employer emetteur = getCurrentUser();

        Facture facture = factureRepository.findByIdWithRelations(factureId)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée: " + factureId));

        // Vérifier que l'utilisateur est bien l'émetteur
        if (!facture.getEmetteur().getId().equals(emetteur.getId())) {
            throw new UnauthorizedException("Seul l'émetteur peut envoyer cette facture");
        }

        Employer client = employerRepository.findById(dto.getClientId())
                .orElseThrow(() -> new ResourceNotFoundException("Client non trouvé: " + dto.getClientId()));

        // Vérifier qu'on n'envoie pas au Super Admin
        if (isSuperAdmin(client)) {
            throw new IllegalArgumentException("Impossible d'envoyer une facture au Super Administrateur");
        }

        // Mettre à jour les infos de dispatch
        facture.setClient(client);
        facture.setMessage(dto.getMessage());
        facture.setDateEnvoi(LocalDateTime.now());
        facture.setEstConsultee(false);

        Facture saved = factureRepository.save(facture);

        // Publier l'événement de dispatch
        eventPublisher.publishEvent(new FactureDispatchedEvent(
                this, saved, emetteur, client, dto.getMessage()));

        // Audit : dispatch d'une facture
        auditLogService.record(emetteur, AuditActionType.DISPATCH,
                "Envoi de la facture " + saved.getNumeroFacture() + " à " + client.getName(),
                "Facture", saved.getId(), saved.getNumeroFacture());

        log.info("📨 Facture {} envoyée à {}", saved.getNumeroFacture(), client.getEmail());

        return enrich(factureMapper.toResponseDTO(saved), saved);
    }

    @Transactional
    public void markAsConsulted(Long factureId) {
        Employer currentUser = getCurrentUser();

        Facture facture = factureRepository.findById(factureId)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvée: " + factureId));

        // Seul le client peut marquer comme consultée
        if (facture.getClient() == null || !facture.getClient().getId().equals(currentUser.getId())) {
            throw new UnauthorizedException("Vous n'êtes pas le destinataire de cette facture");
        }

        facture.marquerCommeConsultee();
        factureRepository.save(facture);

        log.info("Facture {} marquée comme consultée par {}", factureId, currentUser.getEmail());
    }

    @Transactional(readOnly = true)
    public List<FactureResponseDTO> getReceivedFactures() {
        Employer currentUser = getCurrentUser();
        return factureRepository.findByClientId(currentUser.getId())
                .stream()
                .map(f -> enrich(factureMapper.toResponseDTO(f), f))
                .collect(Collectors.toList());
    }

    @Transactional(readOnly = true)
    public List<FactureResponseDTO> getUnconsultedFactures() {
        Employer currentUser = getCurrentUser();
        return factureRepository.findByClientIdAndEstConsulteeFalse(currentUser.getId())
                .stream()
                .map(f -> enrich(factureMapper.toResponseDTO(f), f))
                .collect(Collectors.toList());
    }

    @Transactional(readOnly = true)
    public List<FactureResponseDTO> getSentFactures() {
        Employer currentUser = getCurrentUser();
        return factureRepository.findByEmetteurId(currentUser.getId())
                .stream()
                .map(f -> enrich(factureMapper.toResponseDTO(f), f))
                .collect(Collectors.toList());
    }

    // ─── Utilitaires ─────────────────────────────────────────────────────────

    // ==================== OHADA - comptabilite (SYSCOHADA revise) ====================

    /** Numerotation sequentielle OHADA FAC-ANNEE-NNNN (par entreprise et exercice). */
    private void attribuerNumerotation(Facture facture) {
        if (facture.getNumeroSequence() != null) return;
        Integer annee = facture.getDateEmission() != null
                ? facture.getDateEmission().getYear() : LocalDate.now().getYear();
        facture.setSequenceAnnee(annee);
        Long lastSeq = null;
        if (facture.getEntreprise() != null) {
            List<Facture> prev = factureRepository.findByEntrepriseIdAndSequenceAnneeOrderByNumeroSequenceDesc(
                    facture.getEntreprise().getId(), annee);
            lastSeq = prev.isEmpty() ? null : prev.get(0).getNumeroSequence();
        } else {
            List<Facture> prev = factureRepository.findBySequenceAnneeOrderByNumeroSequenceDesc(annee);
            lastSeq = prev.isEmpty() ? null : prev.get(0).getNumeroSequence();
        }
        long next = (lastSeq == null ? 0 : lastSeq) + 1;
        facture.setNumeroSequence(next);
        // Cycle achat/vente : préfixe par type de document (exigence SYSCOHADA : séquence continue).
        String prefix = "FAC";
        if (facture.getTypeFacture() == Facture.TypeFacture.PROFORMA) prefix = "PRO";
        else if (facture.getTypeFacture() == Facture.TypeFacture.BON_COMMANDE) prefix = "BC";
        else if (facture.getTypeFacture() == Facture.TypeFacture.AVOIR) prefix = "AV";
        facture.setNumeroFacture(String.format("%s-%d-%04d", prefix, annee, next));
    }

    /** Validation comptable : statut VALIDEE + ecritures du journal de vente. */
    @Transactional
    public FactureResponseDTO valider(Long id) {
        Facture facture = factureRepository.findByIdWithRelations(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvee : " + id));
        if (facture.getStatut() == Facture.StatutFacture.VALIDEE
                || facture.getStatut() == Facture.StatutFacture.PAYEE
                || facture.getStatut() == Facture.StatutFacture.PARTIELLEMENT_PAYEE) {
            throw new IllegalArgumentException("La facture " + facture.getNumeroFacture() + " est deja validee");
        }
        facture.setStatut(Facture.StatutFacture.VALIDEE);
        facture.calculerMontants();
        Facture saved = factureRepository.save(facture);
        genererEcrituresVente(saved);
        auditLogService.record(getCurrentUser(), AuditActionType.UPDATE,
                "Validation comptable de la facture " + saved.getNumeroFacture(),
                "Facture", saved.getId(), saved.getNumeroFacture());
        return enrich(factureMapper.toResponseDTO(saved), saved);
    }

    /**
     * Contextualisation : compte produit SYSCOHADA deduit du module comptable interne.
     * 500/503/504 -> 706 Services ; 501 -> 701 Produits finis ; 502 -> 707 Marchandises.
     */
    private String compteProduitDuModule(String module) {
        if (module == null) return "706";
        switch (module) {
            case "501": return "701";
            case "502": return "707";
            default: return "706"; // 500, 503, 504, AUTRE
        }
    }

    /**
     * Journal de vente SYSCOHADA contextualise :
     * - REGULIERE/SOLDE : D 411 Clients / C 701-706-707 Produits / C 4431 TVA collectee ;
     * - facture NON assujettie (interne) : pas d'ecriture 4431 (pas de TVA) ;
     * - AVOIR : inverse (D 709 RRR accordees + D 4431 / C 411 Clients) ;
     * - ACOMPTE : avance client (C 4191 Clients - avances et acomptes recus).
     */
    private void genererEcrituresVente(Facture f) {
        LocalDate date = f.getDateEmission() != null ? f.getDateEmission() : LocalDate.now();
        String clientLib = f.getClient() != null ? f.getClient().getName()
                : (f.getNomDestinataire() != null ? f.getNomDestinataire() : "Client divers");
        boolean avoir = f.getTypeFacture() == Facture.TypeFacture.AVOIR;
        boolean acompte = f.getTypeFacture() == Facture.TypeFacture.ACOMPTE;
        boolean assujetti = !Boolean.FALSE.equals(f.getAssujettiTVA());

        if (acompte) {
            // ACOMPTE : avance recue du client -> C 4191 (pas de produit, pas de TVA)
            ecritureComptableRepository.save(EcritureComptable.builder()
                    .facture(f).journal(EcritureComptable.Journal.VENTE).date(date)
                    .compte("4191").libelle("Avance client - " + f.getNumeroFacture() + " - " + clientLib)
                    .debit(BigDecimal.ZERO).credit(f.getMontantTTC()).build());
            ecritureComptableRepository.save(EcritureComptable.builder()
                    .facture(f).journal(EcritureComptable.Journal.VENTE).date(date)
                    .compte("411").libelle("Client - " + f.getNumeroFacture() + " - " + clientLib)
                    .debit(f.getMontantTTC()).credit(BigDecimal.ZERO).build());
            return;
        }

        // Produits (ou RRR accordees pour un avoir) par compte de ligne
        java.util.Map<String, BigDecimal> parCompte = new java.util.LinkedHashMap<>();
        for (LigneFacture l : f.getLignesFacture()) {
            String compte = l.getCompteComptable() == null ? "706" : l.getCompteComptable();
            if (avoir) compte = "709"; // 709 : Rabais, remises et ristournes accordees
            parCompte.merge(compte,
                    l.getMontantTotal() == null ? BigDecimal.ZERO : l.getMontantTotal(), BigDecimal::add);
        }
        parCompte.forEach((compte, montant) -> ecritureComptableRepository.save(EcritureComptable.builder()
                .facture(f).journal(EcritureComptable.Journal.VENTE).date(date)
                .compte(compte).libelle((avoir ? "Avoir - " : "Vente - ") + f.getNumeroFacture() + " - " + f.getTitre())
                .debit(avoir ? montant : BigDecimal.ZERO)
                .credit(avoir ? BigDecimal.ZERO : montant).build()));

        if (assujetti && f.getMontantTVA().signum() > 0) {
            ecritureComptableRepository.save(EcritureComptable.builder()
                    .facture(f).journal(EcritureComptable.Journal.VENTE).date(date)
                    .compte("4431").libelle((avoir ? "TVA sur avoir - " : "TVA collectee - ") + f.getNumeroFacture())
                    .debit(avoir ? f.getMontantTVA() : BigDecimal.ZERO)
                    .credit(avoir ? BigDecimal.ZERO : f.getMontantTVA()).build());
        }

        ecritureComptableRepository.save(EcritureComptable.builder()
                .facture(f).journal(EcritureComptable.Journal.VENTE).date(date)
                .compte("411").libelle((avoir ? "Avoir client - " : "Client - ") + f.getNumeroFacture() + " - " + clientLib)
                .debit(avoir ? BigDecimal.ZERO : f.getMontantTTC())
                .credit(avoir ? f.getMontantTTC() : BigDecimal.ZERO).build());
    }
    /** Encaissement OHADA : D 512/571 Tresorerie / C 411 Clients + mise a jour du statut. */
    @Transactional
    public FactureResponseDTO enregistrerPaiement(Long id, PaiementFactureRequestDTO dto) {
        Facture facture = factureRepository.findByIdWithRelations(id)
                .orElseThrow(() -> new ResourceNotFoundException("Facture non trouvee : " + id));
        if (dto.getMontant() == null || dto.getMontant().signum() <= 0) {
            throw new IllegalArgumentException("Le montant du paiement doit etre positif");
        }
        BigDecimal dejaPaye = facture.getMontantPaye() == null ? BigDecimal.ZERO : facture.getMontantPaye();
        BigDecimal restant = facture.getMontantTTC().subtract(dejaPaye);
        if (dto.getMontant().compareTo(restant) > 0) {
            throw new IllegalArgumentException("Le paiement depasse le montant restant (" + restant + " FCFA)");
        }
        PaiementFacture p = PaiementFacture.builder()
                .facture(facture)
                .datePaiement(dto.getDatePaiement() != null ? dto.getDatePaiement() : LocalDate.now())
                .mode(dto.getMode())
                .montant(dto.getMontant())
                .reference(dto.getReference())
                .note(dto.getNote())
                .compteComptable(dto.getMode() != null ? dto.getMode().getCompteComptable() : "571")
                .enregistrePar(getCurrentUser())
                .build();
        paiementFactureRepository.save(p);
        ecritureComptableRepository.save(EcritureComptable.builder()
                .facture(facture).journal(EcritureComptable.Journal.TRESORERIE)
                .date(p.getDatePaiement()).compte(p.getCompteComptable())
                .libelle("Encaissement " + p.getMode() + " - " + facture.getNumeroFacture()
                        + (p.getReference() != null ? " (" + p.getReference() + ")" : ""))
                .debit(p.getMontant()).credit(BigDecimal.ZERO).build());
        ecritureComptableRepository.save(EcritureComptable.builder()
                .facture(facture).journal(EcritureComptable.Journal.TRESORERIE)
                .date(p.getDatePaiement()).compte(facture.getTypeFacture() == Facture.TypeFacture.ACOMPTE ? "4191" : "411")
                .libelle((facture.getTypeFacture() == Facture.TypeFacture.ACOMPTE ? "Avance client - " : "Reglement client - ") + facture.getNumeroFacture())
                .debit(BigDecimal.ZERO).credit(p.getMontant()).build());

        facture.setMontantPaye(dejaPaye.add(p.getMontant()));
        facture.calculerMontants();
        facture = factureRepository.save(facture);
        updateBudgetProjet(facture);
        auditLogService.record(getCurrentUser(), AuditActionType.UPDATE,
                "Paiement de " + p.getMontant() + " FCFA (" + p.getMode() + ") sur la facture " + facture.getNumeroFacture(),
                "Facture", facture.getId(), facture.getNumeroFacture());
        return enrich(factureMapper.toResponseDTO(facture), facture);
    }

    @Transactional(readOnly = true)
    public List<PaiementFactureResponseDTO> getPaiements(Long factureId) {
        return paiementFactureRepository.findByFactureIdOrderByDatePaiementDesc(factureId).stream()
                .map(this::toPaiementDTO).collect(Collectors.toList());
    }

    private PaiementFactureResponseDTO toPaiementDTO(PaiementFacture p) {
        PaiementFactureResponseDTO dto = new PaiementFactureResponseDTO();
        dto.setId(p.getId());
        dto.setFactureId(p.getFacture() != null ? p.getFacture().getId() : null);
        dto.setMode(p.getMode());
        dto.setMontant(p.getMontant());
        dto.setDatePaiement(p.getDatePaiement());
        dto.setReference(p.getReference());
        dto.setNote(p.getNote());
        dto.setCompteComptable(p.getCompteComptable());
        if (p.getEnregistrePar() != null) {
            dto.setEnregistreParId(p.getEnregistrePar().getId());
            dto.setEnregistreParNom(p.getEnregistrePar().getName());
        }
        dto.setDateCreation(p.getDateCreation());
        return dto;
    }

    @Transactional(readOnly = true)
    public List<EcritureComptableResponseDTO> getEcritures(Long factureId) {
        return ecritureComptableRepository.findByFactureIdOrderByDateAscIdAsc(factureId).stream()
                .map(this::toEcritureDTO).collect(Collectors.toList());
    }

    /** Journal de vente OHADA (ecritures de vente, scope entreprise). */
    @Transactional(readOnly = true)
    public List<EcritureComptableResponseDTO> getJournalVente() {
        Long scope = entrepriseContextService.getScopeEntrepriseId();
        return ecritureComptableRepository.findByJournalOrderByDateAsc(EcritureComptable.Journal.VENTE).stream()
                .filter(e -> e.getFacture() == null || scope == null
                        || (e.getFacture().getEntreprise() != null && scope.equals(e.getFacture().getEntreprise().getId())))
                .map(this::toEcritureDTO).collect(Collectors.toList());
    }

    /** Balance agee clients (OHADA 411) : encours par tranches 0-30 / 31-60 / 61-90 / +90 jours. */
    @Transactional(readOnly = true)
    public List<java.util.Map<String, Object>> getBalanceAgee() {
        Long scope = entrepriseContextService.getScopeEntrepriseId();
        List<Facture> factures = scope != null ? factureRepository.findByEntrepriseId(scope) : factureRepository.findAll();
        LocalDate today = LocalDate.now();
        List<java.util.Map<String, Object>> rows = new java.util.ArrayList<>();
        for (Facture f : factures) {
            if (f.getStatut() == Facture.StatutFacture.PAYEE || f.getStatut() == Facture.StatutFacture.ANNULEE) continue;
            BigDecimal restant = f.getMontantTTC().subtract(f.getMontantPaye() == null ? BigDecimal.ZERO : f.getMontantPaye());
            if (restant.signum() <= 0) continue;
            long jours = f.getDateEmission() != null ? ChronoUnit.DAYS.between(f.getDateEmission(), today) : 0;
            java.util.Map<String, Object> row = new java.util.LinkedHashMap<>();
            row.put("factureId", f.getId());
            row.put("numeroFacture", f.getNumeroFacture());
            row.put("titre", f.getTitre());
            row.put("client", f.getClient() != null ? f.getClient().getName() : f.getNomDestinataire());
            row.put("dateEmission", f.getDateEmission() != null ? f.getDateEmission().toString() : null);
            row.put("montantRestant", restant);
            row.put("jours", jours);
            row.put("tranche", jours <= 30 ? "0-30" : jours <= 60 ? "31-60" : jours <= 90 ? "61-90" : ">90");
            rows.add(row);
        }
        return rows;
    }

    private EcritureComptableResponseDTO toEcritureDTO(EcritureComptable e) {
        EcritureComptableResponseDTO dto = new EcritureComptableResponseDTO();
        dto.setId(e.getId());
        if (e.getFacture() != null) {
            dto.setFactureId(e.getFacture().getId());
            dto.setNumeroFacture(e.getFacture().getNumeroFacture());
        }
        dto.setJournal(e.getJournal());
        dto.setDate(e.getDate());
        dto.setCompte(e.getCompte());
        dto.setLibelle(e.getLibelle());
        dto.setDebit(e.getDebit());
        dto.setCredit(e.getCredit());
        dto.setDateCreation(e.getDateCreation());
        return dto;
    }
    private FactureResponseDTO enrich(FactureResponseDTO dto, Facture facture) {
        if (facture.getMontantTTC() != null
                && facture.getMontantTTC().compareTo(BigDecimal.ZERO) > 0
                && facture.getMontantPaye() != null) {
            double pct = facture.getMontantPaye()
                    .divide(facture.getMontantTTC(), 4, RoundingMode.HALF_UP)
                    .multiply(BigDecimal.valueOf(100))
                    .doubleValue();
            dto.setPourcentagePaye(pct);
        } else {
            dto.setPourcentagePaye(0.0);
        }

        dto.setEstPayee(facture.getStatut() == Facture.StatutFacture.PAYEE);
        dto.setEstEnRetard(facture.getStatut() == Facture.StatutFacture.EN_RETARD); // historique uniquement

        if (facture.getDateEmission() != null) {
            dto.setDelaiEmissionPaiement(ChronoUnit.DAYS.between(facture.getDateEmission(), LocalDate.now()));
        }
        return dto;
    }

    private void updateBudgetProjet(Facture facture) {
        if (facture.getProjet() == null) return;
        Long projetId = facture.getProjet().getId();
        BigDecimal total = factureRepository.sumMontantTTCByProjetId(projetId);
        Projet projet = facture.getProjet();
        projet.setBudgetConsomme(total);
        projet.updateBudget();
        projetRepository.save(projet);
    }

    private Employer getCurrentUser() {
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        return employerRepository.findByEmailWithRolesAndPoste(auth.getName())
                .orElseThrow(() -> new ResourceNotFoundException("Utilisateur courant non trouvé"));
    }

    private boolean isSuperAdmin(Employer employer) {
        return employer.getRole() != null &&
                "SUPER_ADMIN".equalsIgnoreCase(employer.getRole().getName());
    }
}